# Copy to .env.local and fill in.
# AI judge — any OpenAI-compatible API (OpenAI, Groq, OpenRouter, local Ollama…). Leave LLM_API_KEY empty for rules-only mode.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Optional dedicated injection classifier (served by Groq). Leave empty to disable.
PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m

# Solana
NEXT_PUBLIC_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional: use an existing SPL mint (e.g. Circle devnet USDC) instead of the self-minted demo token.
# DEMO_MINT=
# Optional: where agent/merchant keys and state are stored (default ./data).
# INTENTGUARD_DATA_DIR=
